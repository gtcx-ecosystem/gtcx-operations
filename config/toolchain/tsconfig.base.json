{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rootDir": "../../03-platform/src",
    "outDir": "../../dist"
  },
  "include": [
    "../../03-platform/src/**/*"
  ],
  "exclude": [
    "../../node_modules",
    "../../dist",
    "../../**/*.test.ts",
    "../../vitest.config.ts",
    "../../03-platform/scripts/**"
  ]
}
